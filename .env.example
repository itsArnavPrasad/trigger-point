# Copy to .env (gitignored). The app reads .env automatically; values in .env take
# precedence over variables inherited from your shell.

# Provider modes: live | replay (default replay). Each run records the modes it used.
WEB_MODE=replay
LLM_MODE=replay
CRUSTDATA_MODE=replay

# LLM: Hyde inference gateway (OpenAI chat-completions format). Required when LLM_MODE=live.
HYDE_INFERENCE_API_KEY=
HYDE_BASE_URL=https://inference.hyde.tech/v1
LLM_MODEL=hyde/glm-5.3-flash

# Crustdata. Required when CRUSTDATA_MODE=live.
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
# Hard cap on credits a single run may spend (fails closed).
CRUSTDATA_RUN_CREDIT_BUDGET=5
# Live only: also buy email and phone for the buyers found (about 3 credits per person matched,
# nothing for people it cannot match). Raise the cap above if you want every buyer covered.
CRUSTDATA_FETCH_CONTACTS=true

# Application
DATABASE_URL=sqlite:///./trigger_point.db
# TRIGGER_POINT_FIXTURES_DIR=./fixtures/replay

# Safety: external sending is not implemented. Setting either to true makes startup fail.
ENABLE_EMAIL_SEND=false
ENABLE_LINKEDIN_SEND=false

# The only inboxes a test email or invite may reach. Empty blocks everything.
TRIGGER_POINT_TEST_RECIPIENTS=
